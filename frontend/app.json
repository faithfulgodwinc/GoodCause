{
  "expo": {
    "name": "goodcause",
    "slug": "frontend",
    "version": "1.0.60",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goodcause",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goodcause.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos to tell your campaign story",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 63,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.goodcause.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos to tell your campaign story"
        }
      ],
      "expo-video",
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aacde183-52e9-4d71-8c2e-e2db6008ca49"
      }
    }
  }
}
